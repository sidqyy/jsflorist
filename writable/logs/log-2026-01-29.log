 1 APPPATH/Controllers/Home.php(311): mb_convert_encoding('<p>Hari gini masih bingung, memilih bunga sesuai makna untuk hadiah,atau bunga yg kita kasihkan buat orang spesial benar benar sampai pesan&amp;makna yg kita sampaikan dalam bunga ini,sini kita kasih sedikit tips,okkey</p><h5 class="">Yg pertama&nbsp;</h5><p><span style="font-size: 1rem;">Untuk memilih bunga hadiah yang bermakna, sesuaikan dengan makna warna dan jenis bunga,&nbsp;</span><span style="font-size: 1rem;">Misal :</span></p><p>&nbsp;Mawar: Merah (cinta, gairah), Putih (ketulusan, kemurnian), Kuning (persahabatan, kebahagiaan), Pink (kasih sayang, kelembutan).</p><p>Matahari: Kebahagiaan, keceriaan, semangat (cocok untuk teman atau ucapan terima kasih).</p><p>Tulip: Merah (cinta), Kuning (keceriaan), melambangkan kebahagiaan dan harapan.</p><p>Anggrek/Lili Putih: Elegan, kemurnian, penghormatan (cocok untuk yang berwibawa atau acara formal).</p><h5 class="">Yang kedua&nbsp;</h5><p>Pilih sesuai karakter si penerima,alasan nya karena Karakter seseorang sangat berpengaruh pada jenis bunga yang cocok untuknya. Ada orang yang penuh semangat dan ceria, ada pula yang anggun dan tenang. Masing-masing pribadi ini bisa diwakili dengan jenis bunga yang berbeda. Misalnya, seseorang yang berjiwa romantis akan lebih cocok menerima mawar merah atau pink, sementara pribadi yang elegan akan lebih terkesan dengan bunga lily atau anggrek.</p><h5 class="">Yang ketiga&nbsp;</h5><p> pertimbangan jenis acara,misal untuk ulang tahun, anniversary, wisuda,atau buat perayaan kecil.</p><p>Nah itu sedikit tips dari kita ya,semoga bermanfaat.sampai jumpa di artikel berikutnya....</p>', 'HTML-ENTITIES', 'UTF-8')
 2 APPPATH/Controllers/Home.php(277): App\Controllers\Home->_processBase64Images('<p>Hari gini masih bingung, memilih bunga sesuai makna untuk hadiah,atau bunga yg kita kasihkan buat orang spesial benar benar sampai pesan&amp;makna yg kita sampaikan dalam bunga ini,sini kita kasih sedikit tips,okkey</p><h5 class="">Yg pertama&nbsp;</h5><p><span style="font-size: 1rem;">Untuk memilih bunga hadiah yang bermakna, sesuaikan dengan makna warna dan jenis bunga,&nbsp;</span><span style="font-size: 1rem;">Misal :</span></p><p>&nbsp;Mawar: Merah (cinta, gairah), Putih (ketulusan, kemurnian), Kuning (persahabatan, kebahagiaan), Pink (kasih sayang, kelembutan).</p><p>Matahari: Kebahagiaan, keceriaan, semangat (cocok untuk teman atau ucapan terima kasih).</p><p>Tulip: Merah (cinta), Kuning (keceriaan), melambangkan kebahagiaan dan harapan.</p><p>Anggrek/Lili Putih: Elegan, kemurnian, penghormatan (cocok untuk yang berwibawa atau acara formal).</p><h5 class="">Yang kedua&nbsp;</h5><p>Pilih sesuai karakter si penerima,alasan nya karena Karakter seseorang sangat berpengaruh pada jenis bunga yang cocok untuknya. Ada orang yang penuh semangat dan ceria, ada pula yang anggun dan tenang. Masing-masing pribadi ini bisa diwakili dengan jenis bunga yang berbeda. Misalnya, seseorang yang berjiwa romantis akan lebih cocok menerima mawar merah atau pink, sementara pribadi yang elegan akan lebih terkesan dengan bunga lily atau anggrek.</p><h5 class="">Yang ketiga&nbsp;</h5><p> pertimbangan jenis acara,misal untuk ulang tahun, anniversary, wisuda,atau buat perayaan kecil.</p><p>Nah itu sedikit tips dari kita ya,semoga bermanfaat.sampai jumpa di artikel berikutnya....</p>')
